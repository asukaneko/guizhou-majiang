{
  "name": "guizhou-mahjong",
  "version": "1.0.0",
  "private": true,
  "description": "贵州麻将 · 贵阳捉鸡 / 幺筒麻将 网页联机",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "start:desktop": "node scripts/launch.js",
    "shot": "node scripts/launch.js --shot --shot-mode=table --shot-path=output/table.png",
    "shot:lobby": "node scripts/launch.js --shot --shot-mode=lobby --shot-path=output/lobby.png",
    "shot:preview": "node scripts/launch.js --shot --shot-url=src/preview.html --shot-path=output/tiles.png",
    "sim": "node scripts/sim.cjs",
    "sim:yitong": "node scripts/sim.cjs --mode=yitong",
    "server": "node server/index.js",
    "e2e": "node scripts/e2e.cjs",
    "e2e:ui": "node scripts/e2e-render.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
